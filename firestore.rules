rules_version = '2';
  service cloud.firestore {
    match /databases/{database}/documents {
      function isWhitelisted() {        return request.auth != null &&
               exists(/databases/$(database)/documents/wms_users/$(request.auth.token.email));      }
      function isAdmin() {
        return isWhitelisted() &&
               get(/databases/$(database)/documents/wms_users/$(request.auth.token.email)).data.role == 'admin';
      }
      function isOperator() {
        return isWhitelisted() &&
               get(/databases/$(database)/documents/wms_users/$(request.auth.token.email)).data.role != 'viewer';
      }
      // Quem enxerga a auditoria: administrador, ou quem recebeu o módulo
      // 'auditoria' no cadastro de usuários.
      function podeAuditar() {
        return isAdmin() ||
               (isWhitelisted() &&
                get(/databases/$(database)/documents/wms_users/$(request.auth.token.email)).data.get('modules', []).hasAny(['auditoria']));
      }

      match /wms_items/{d}              { allow read: if isWhitelisted(); allow write: if isOperator(); }
      match /wms_addresses/{d}          { allow read: if isWhitelisted(); allow write: if isAdmin(); }
      match /wms_import_log/{d}         { allow read: if isWhitelisted(); allow write: if isAdmin(); }
      match /wms_unaddressed/{d}        { allow read: if isWhitelisted(); allow write: if isOperator(); }
      match /wms_export_log/{d}         { allow read: if isAdmin();       allow write: if isWhitelisted(); }
      match /wms_users/{email} {
        allow read: if isAdmin() || request.auth.token.email == email;
        allow write: if isAdmin();
        // A própria pessoa confirma no seu cadastro que já trocou a senha do
        // coletor. Sem isto, quem não é administrador esbarra em "Missing or
        // insufficient permissions" bem na troca obrigatória do primeiro acesso.
        // São só estes dois campos, e só no próprio documento: papel, módulos e
        // ativo seguem sendo decisão de administrador, senão qualquer operador
        // se promoveria a admin por esta mesma porta.
        allow update: if request.auth != null
                      && request.auth.token.email == email
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['mustChangePassword', 'senhaDefinidaEm'])
                      && request.resource.data.mustChangePassword == false;
      }
      // Trilha de auditoria do endereçamento: quem endereçou, transferiu, liberou.
      // Qualquer usuário da allowlist grava (o coletor registra o próprio trabalho),
      // mas ninguém edita nem apaga: sem update e sem delete, o registro é definitivo.
      // Se um operador pudesse alterar o próprio log, a trilha não provaria nada.
      match /wms_mov_log/{d}            { allow read: if podeAuditar(); allow create: if isWhitelisted(); }
      match /wms_limpeza_log/{d}        { allow read: if podeAuditar(); allow create: if isAdmin(); }
      match /coletor_pedidos/{d}        { allow read: if isWhitelisted(); allow write: if isAdmin(); }
      match /coletor_divergencias/{d}   { allow read: if isWhitelisted(); allow write: if isWhitelisted(); }
      match /coletor_lotes/{d}          { allow read: if isWhitelisted(); allow write: if isWhitelisted(); }
      match /coletor_logs/{d}           { allow read: if isAdmin();       allow write: if isWhitelisted(); }
    }
  }
